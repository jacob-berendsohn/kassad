<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Single package source, deliberately. Central Package Management raises NU1507 (an error under
    TreatWarningsAsErrors) whenever more than one feed is configured on the machine, and a library
    that ends up on nuget.org should not restore from anyone's private feeds anyway. Add a feed only
    together with packageSourceMapping.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
