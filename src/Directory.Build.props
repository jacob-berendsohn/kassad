<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Public API tracking. The surface was baselined in PublicAPI.Unshipped.txt in roadmap 0.4, so
      RS0016/RS0017 (plus RS0026/RS0027 for overloads) are errors like every other warning: a public
      change that is not reflected in the API file fails the build. Update it with the RS0016 code fix.
      The analyzer package registers PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt as
      AdditionalFiles itself (its build targets add both when they exist next to the project). Do not
      add them here again: the dotnet format workspace would load each file twice and the RS0016 code
      fix would apply nothing.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <!--
      Each package carries its own README.md (what it is, install, the Quick start lines that matter, one link back
      to the repository README), not the repository README: nuget.org renders the packed file as the package page,
      and the root README's generated Numbers block is three hundred lines of tables that belong on GitHub, not
      there. PackageReadmeFile in the root props names the file.
    -->
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
