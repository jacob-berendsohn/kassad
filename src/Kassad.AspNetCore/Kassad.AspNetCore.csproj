<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kassad.AspNetCore</RootNamespace>
    <Description>ASP.NET Core integration for Kassad: inbound middleware for your own LLM-facing endpoints, and a DelegatingHandler that screens prompts and completions on the HttpClient you use to call OpenAI, Anthropic, or Azure OpenAI. Zero changes to application code.</Description>
    <PackageTags>$(PackageTags);delegatinghandler;httpclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kassad/Kassad.csproj" />
  </ItemGroup>

</Project>
