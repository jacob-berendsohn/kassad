<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kassad.AspNetCore</RootNamespace>
    <Description>Kassad for ASP.NET Core: inbound middleware for your endpoints and a DelegatingHandler for the HttpClient that talks to your LLM provider.</Description>
    <PackageTags>$(PackageTags);aspnetcore;middleware;DelegatingHandler;httpclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kassad/Kassad.csproj" />
  </ItemGroup>

</Project>
