<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kassad.TypeSafe</RootNamespace>
    <Description>.NET client for TypeSafe's System One API (Jev). Typed Noul/Choice/Score questions in, calibrated probabilities out. Implements Kassad.IDecisionModel so it plugs straight into the Kassad guardrail engine, and is usable standalone.</Description>
    <PackageTags>$(PackageTags);client;sdk;system-one</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kassad.Abstractions/Kassad.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
