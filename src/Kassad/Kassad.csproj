<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kassad</RootNamespace>
    <Description>Calibrated guardrails for LLM applications. Declare policies as data, get confidence-gated Allow/Flag/Review/Block verdicts from a System One decision model (TypeSafe Jev or any IDecisionModel), and keep control flow in your code. This is the engine; pair with Kassad.TypeSafe and Kassad.AspNetCore.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kassad.Abstractions/Kassad.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
