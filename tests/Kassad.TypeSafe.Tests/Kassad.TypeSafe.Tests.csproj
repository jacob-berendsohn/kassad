<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/Kassad.TypeSafe/Kassad.TypeSafe.csproj" />
    <!-- The engine-level live tests (GuardrailEngineLiveTests, roadmap 3.1) run policies through GuardrailEngine against the real client. -->
    <ProjectReference Include="../../src/Kassad/Kassad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets FixtureRecorder write recorded responses back into the source tree, wherever the build output lands. -->
    <AssemblyMetadata Include="Kassad.FixturesSourceDirectory" Value="$(MSBuildProjectDirectory)/Fixtures" />
  </ItemGroup>
</Project>
